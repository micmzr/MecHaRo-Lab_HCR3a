<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="gripper_ros2_control" params="name prefix use_fake_hardware:=true">
    <ros2_control name="${name}" type="system">
      <hardware>
        <!-- ros2_control simulation -->
        <xacro:if value="${use_fake_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:if>
        <!-- physical hardware or Rodi simulation -->
        <xacro:unless value="${use_fake_hardware}">
          <plugin>hcr_gripper/Gripper</plugin>
        </xacro:unless>
      </hardware>
      <joint name="${prefix}finger1">
        <command_interface name="position" />
        <state_interface name="position">
          <param name="initial_value">0.0</param>
          <param name="min">0</param>
          <param name="max">0.0255</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="max">0.0001</param>
        </state_interface>
      </joint>
      <!-- joint name="${prefix}finger2">
        <param name="mimic">${prefix}finger1</param>
        <param name="multiplier">-1</param>
        <command_interface name="position" />
        <state_interface name="position">
          <param name="initial_value">0.0</param>
          <param name="min">-0.0255</param>
          <param name="max">0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="max">0.0001</param>
        </state_interface>
      </joint -->      
    </ros2_control>
  </xacro:macro>

</robot>
