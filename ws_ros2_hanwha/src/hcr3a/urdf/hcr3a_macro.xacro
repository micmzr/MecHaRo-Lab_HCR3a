    <!-- end of link list -->

  <joint name="${prefix}joint_1" type="revolute">
    <origin xyz="0 0 0.03769" rpy="1.5708 0 1.5708" />
    <parent link="${prefix}base_link" />
    <child link="${prefix}link_1" />
    <axis xyz="0 1 0"  />
    <limit lower="-6.2832" upper="6.2832" effort="150.0" velocity="3.1416" />
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="${prefix}joint_2" type="revolute">
    <origin xyz="-0.06 0.10091 0" rpy="-1.5708 0 0"  />
    <parent link="${prefix}link_1" />
    <child link="${prefix}link_2" />
    <axis xyz="-1 0 0" />
    <limit lower="-6.2832" upper="6.2832" effort="150.0" velocity="3.1416" />
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="${prefix}joint_3" type="revolute">
    <origin xyz="0 0.201 0" rpy="0 0 0" />
    <parent link="${prefix}link_2" />
    <child link="${prefix}link_3" />
    <axis xyz="-1 0 0" />
    <limit lower="-2.7925" upper="2.7925" effort="150.0" velocity="3.1416" />
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="${prefix}joint_4" type="revolute">
    <origin xyz="-0.043643 0.2815 -0.00013246" rpy="-1.5708 0 0" />
    <parent link="${prefix}link_3" />
    <child link="${prefix}link_4" />
    <axis xyz="-1 0 0" />
    <limit lower="-6.2832" upper="6.2832" effort="150." velocity="6.2832" />
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="${prefix}joint_5" type="revolute">
    <origin xyz="-0.044744 0.103 0" rpy="0 0 0" />
    <parent link="${prefix}link_4" />
    <child link="${prefix}link_5" />
    <axis xyz="0 1 0" />
    <limit lower="-6.2832" upper="6.2832" effort="150.0" velocity="6.2832" />
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="${prefix}joint_6" type="revolute">
    <origin xyz="-0.10284 0.0445 -0.00011784" rpy="0 0 0" />
    <parent link="${prefix}link_5" />
    <child link="${prefix}link_6" />
    <axis xyz="-1 0 0" />
    <limit lower="-3.146" upper="3.146" effort="150.0" velocity="6.2832" />
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="${prefix}camera" type="fixed">
    <origin xyz="-0.078661 0.105 -0.00053185" rpy="2.939 1.5651 1.3693" />
    <parent link="${prefix}link_6" />
    <child link="${prefix}camera_Link" />
    <axis xyz="0 0 0" />
  </joint>fixed
  <joint name="${prefix}forcesensor" type="fixed">
    <origin xyz="-0.0010308 0.01738 0.10501" rpy="1.5708 0 0" />
    <parent link="${prefix}camera_Link" />
    <child link="${prefix}forcesensor_Link" />
    <axis xyz="1 0 0" />
    <limit lower="-0.0" upper="0.0" effort="5000.0" velocity="0.01"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="${prefix}gripper" type="fixed">
    <origin xyz="0.001393 -0.0015347 0.158" rpy="1.5716 -0.00082179 0.79973" />
    <parent link="${prefix}forcesensor_Link" />
    <child link="${prefix}effector_Link" />
    <axis xyz="0 0 0" />
  </joint>
  <joint name="${prefix}finger1" type="prismatic">
    <origin xyz="0 -0.0435 -0.014559" rpy="-1.5708 0 -3.1416" />
    <parent link="${prefix}effector_Link" />
    <child link="${prefix}finger1_Link" />
    <axis xyz="0 -1 0" />
    <limit lower="-0.1" upper="0.03" effort="150.0" velocity="1000.0" />
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="${prefix}finger2" type="prismatic">
    <origin xyz="0 -0.0435 0.01" rpy="-1.5708 0 -3.1416" />
    <parent link="${prefix}effector_Link" />
    <child link="${prefix}finger2_Link" />
    <axis xyz="0 -1 0" />
    <limit lower="-0.03" upper="0.1" effort="150.0" velocity="1000.0" />
    <dynamics damping="0" friction="0"/>
    <mimic joint="${prefix}finger1" multiplier="-1" offset="0" />
  </joint>

    <!-- end of joint list -->

    <!-- <link name="${prefix}base" />
    <joint name="${prefix}base_link-base" type="fixed">
      <origin xyz="0 0 0.001" rpy="0 0 0"/>
      <parent link="${prefix}base_link"/>
      <child link="${prefix}base"/>
    </joint> -->

    <!-- ROS-Industrial 'flange' frame- attachment point for EEF models -->
    <link name="${prefix}flange"/>
    <joint type="fixed" name="${prefix}link_6-flange">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${prefix}link_6"/>
      <child link="${prefix}flange"/>
    </joint>

    <!-- ROS-Industrial 'tool0' frame- all-zeros tool frame -->
    <link name="${prefix}tool0" />
    <joint name="${prefix}effector_Link-tool0" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <parent link="${prefix}effector_Link" />
      <child link="${prefix}tool0" />
    </joint>
    
    <!-- OctoMap depth link -->
    <!-- link name="camera_depth_optical_frame" />
    <joint name="{prefix}camera_depth_optical_link" type="fixed">
      <origin xyz="0 0.0095 0.011" rpy="${M_PI} 0 -${M_PI/2}"/>
      <parent link="${prefix}camera_Link" />
      <child link="camera_depth_optical_frame" />
    </joint -->
    

  </xacro:macro>
</robot>
