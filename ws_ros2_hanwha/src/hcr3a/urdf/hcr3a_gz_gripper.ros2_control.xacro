<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="gripper_ros2_control" params="prefix">
    <ros2_control name="gripper" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <joint name="${prefix}finger1">
        <command_interface name="position">
          <param name="min">0</param>
          <param name="max">0.02557</param>
        </command_interface>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <state_interface name="position">
          <param name="initial_value">0.02557</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="effort">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
      <joint name="${prefix}finger2">
        <!-- param name="mimic">${prefix}finger1</param>
        <param name="multiplier">-1</param -->
        <command_interface name="position">
          <param name="min">-0.02557</param>
          <param name="max">0</param>
        </command_interface>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <state_interface name="position">
          <param name="initial_value">-0.02557</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="effort">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>      
    </ros2_control>
  </xacro:macro>

</robot>
